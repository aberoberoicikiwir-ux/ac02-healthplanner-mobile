PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthmaxxing

JWT_SECRET=ganti_dengan_random_string_yang_panjang_dan_rahasia
JWT_EXPIRES_IN=7d

# ---- AI ----
# mock   = AI tiruan, tanpa API key (untuk pengembangan dan tes)
# gemini = Gemini sungguhan (butuh GEMINI_API_KEY dan GEMINI_MODEL)
AI_PROVIDER=mock
GEMINI_API_KEY=isi_nanti_saat_integrasi_ai
# Isi dengan nama model yang tersedia untuk akunmu (cek di Google AI Studio)
GEMINI_MODEL=
# Berapa kali AI boleh mencoba lagi bila hasilnya ditolak validator (1-4)
AI_MAX_ATTEMPTS=2

# Kunci untuk endpoint internal (/api/internal/...). Minimal 16 karakter.
# Kalau kosong atau terlalu pendek, endpoint internal MATI (bukan terbuka).
INTERNAL_API_KEY=GANTI_INI
